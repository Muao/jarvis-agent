#!/usr/bin/env bash
# Root-owned deploy entrypoint (ADR-0016 §5). Installed to /usr/local/sbin/jarvis-deploy (root:root 0755) by
# deploy/root/install-root-deploy.sh, which the OWNER runs by hand; a deploy never installs or updates this file.
#
#   jarvis-deploy <40-hex commit sha>
#
# Why it exists: the checkout in /home/jarvis/jarvis is writable by uid jarvis (worker Bash, check commands,
# a container escape), so root must never execute anything from it. This script lives outside the checkout
# and runs as root ONLY: the lock, the `systemctl restart` calls, the migration's systemd-run wrapper and the
# health wait. Everything that touches the checkout (git, pnpm, the build) runs as `jarvis` through runuser.
#
# The SHA must equal the current refs/heads/main on GitHub (asked as jarvis, over HTTPS), so a caller that can
# only ssh in cannot make the server run an arbitrary commit. The checkout is moved with `git reset --hard`
# to that verified SHA (main's history was rewritten once, so fast-forward-only no longer applies).
# The health check below mirrors scripts/wait-healthy.sh; that file is in the checkout and is not run as root.
set -euo pipefail

DEPLOY_USER=jarvis
REPO_URL="https://github.com/burnjohn/jarvis-agent.git"
REPO_DIR="/home/$DEPLOY_USER/jarvis"
LOCK_FILE=/run/jarvis-deploy.lock
INFISICAL_ENV_FILE=/etc/jarvis/infisical.env
HEALTH_URL="http://127.0.0.1:4310/api/health"

# Read in full before it runs, as in scripts/deploy.sh: nothing here changes mid-run anyway.
main() {
  [ "$(id -u)" -eq 0 ] || {
    echo "jarvis-deploy: must run as root" >&2
    exit 1
  }
  if [ $# -ne 1 ] || ! [[ "$1" =~ ^[0-9a-f]{40}$ ]]; then
    echo "usage: jarvis-deploy <40-hex commit sha>" >&2
    exit 2
  fi
  local sha="$1"

  # Fixed, minimal environment for everything run on the owner's behalf; HOME is explicit because
  # runuser -u does not reliably reset it, and git/pnpm/corepack would otherwise write under /root.
  local -a as_user=(runuser -u "$DEPLOY_USER" -- env "HOME=/home/$DEPLOY_USER")

  exec 9>"$LOCK_FILE"
  flock -n 9 || {
    echo "jarvis-deploy: another deploy is running (lock: $LOCK_FILE)" >&2
    exit 1
  }

  local remote_main
  remote_main="$("${as_user[@]}" git ls-remote "$REPO_URL" refs/heads/main | awk '{print $1}')"
  if ! [[ "$remote_main" =~ ^[0-9a-f]{40}$ ]]; then
    echo "jarvis-deploy: could not read refs/heads/main from GitHub" >&2
    exit 1
  fi
  if [ "$sha" != "$remote_main" ]; then
    echo "jarvis-deploy: refusing: $sha is not the current origin/main ($remote_main)" >&2
    exit 1
  fi

  cd "$REPO_DIR"
  local before
  before="$("${as_user[@]}" git rev-parse HEAD 2>/dev/null || echo none)"
  echo "jarvis-deploy: $before -> $sha"
  "${as_user[@]}" git fetch --quiet "$REPO_URL" main
  # The fetched tip must be the verified commit (guards a push landing between ls-remote and fetch).
  [ "$("${as_user[@]}" git rev-parse FETCH_HEAD)" = "$sha" ] || {
    echo "jarvis-deploy: main moved during the deploy; run again" >&2
    exit 1
  }
  "${as_user[@]}" git reset --hard "$sha"

  echo "jarvis-deploy: installing dependencies..."
  "${as_user[@]}" pnpm install --frozen-lockfile
  echo "jarvis-deploy: building web..."
  "${as_user[@]}" pnpm --filter @jarvis/web build

  echo "jarvis-deploy: running migrations..."
  # The Infisical identity is root-only; the migration (as jarvis, via a transient unit) borrows it as an
  # EnvironmentFile. Without the file (a rehearsal) it falls back to jarvis' own environment.
  if [ -e "$INFISICAL_ENV_FILE" ]; then
    systemd-run --quiet --wait --pipe --collect --uid="$DEPLOY_USER" --same-dir \
      -p "EnvironmentFile=$INFISICAL_ENV_FILE" -p "WorkingDirectory=$REPO_DIR" \
      "$REPO_DIR/scripts/with-secrets.sh" pnpm --filter @jarvis/engine db:migrate
  else
    "${as_user[@]}" scripts/with-secrets.sh pnpm --filter @jarvis/engine db:migrate
  fi

  echo "jarvis-deploy: restarting jarvis-engine..."
  systemctl restart jarvis-engine
  wait_healthy

  if systemctl list-unit-files jarvis-web.service | grep -q '^jarvis-web.service'; then
    echo "jarvis-deploy: restarting jarvis-web..."
    systemctl restart jarvis-web
  else
    echo "jarvis-deploy: jarvis-web.service not installed, skipping"
  fi
  echo "jarvis-deploy: done at ${sha:0:7}"
}

# Same contract as scripts/wait-healthy.sh: 200 ok; 503 = alive, database down (accepted); else keep trying 60 s.
wait_healthy() {
  local code=000 deadline=$((SECONDS + 60))
  while [ "$SECONDS" -lt "$deadline" ]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" || true)"
    case "$code" in
      200) return 0 ;;
      503)
        echo "jarvis-deploy: engine is up, database is not (503)" >&2
        return 0
        ;;
    esac
    sleep 1
  done
  echo "jarvis-deploy: no healthy answer from $HEALTH_URL within 60 s (last status $code)" >&2
  exit 1
}

main "$@"
exit
